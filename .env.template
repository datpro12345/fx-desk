# ==============================================================================
# LLM ANALYST LAYER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.template .env
# Docker (Windows / Oracle VM): docs/docker.md
#   docker compose run --rm weekly
#
# Support:
# 1. Google AI Studio (Gemini Free Tier / Paid)
# 2. OpenRouter (free shortlist: Ling Fin, MiniMax M3)
# ==============================================================================

# Active LLM Provider: 'google' or 'openrouter'
LLM_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 1. Google AI Studio Configuration
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative Google models: gemini-2.5-pro, gemini-2.0-flash

# ------------------------------------------------------------------------------
# 2. OpenRouter Configuration
# Get your key at: https://openrouter.ai/keys
# OpenRouter offers free models with suffix ':free'
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Weekly outlook models come from the shared router (FM_OPENROUTER_TOOLS).
# Optional: OPENROUTER_MODEL is tried after the router chain (paid models allowed).
# OPENROUTER_MODEL=

# ------------------------------------------------------------------------------
# 3. Analyst Output & Timezone Settings
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Ho_Chi_Minh
REPORTS_DIR=reports
# Outlook language: vi | en | any name (ja, es, …)
REPORT_LANG=en
